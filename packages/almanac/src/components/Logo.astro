---
import { config, siteConfig } from "../config";
import { logoMark } from "../assets/logoMark";
import { withBase } from "../lib/paths";

interface Props {
	class?: string;
}

const className = Astro.props.class ?? "logo-mark";

// A configured image replaces the built-in mark. Two sources means one per
// mode, and CSS decides which is visible so there is no flash on load.
const custom = config.logo;
const alt = custom?.alt ?? siteConfig.name;
---

{custom ? (
	<Fragment>
		{custom.light && (
			<img
				class:list={[className, "logo-image", { "logo-image-light": custom.dark }]}
				src={withBase(custom.light)}
				alt={alt}
			/>
		)}
		{custom.dark && (
			<img
				class:list={[className, "logo-image", { "logo-image-dark": custom.light }]}
				src={withBase(custom.dark)}
				alt={custom.light ? "" : alt}
				aria-hidden={custom.light ? "true" : undefined}
			/>
		)}
	</Fragment>
) : (

<svg class={className} viewBox={logoMark.viewBox} role="img" aria-label={siteConfig.name}>
	<path
		d={logoMark.leftLeg}
		fill="none"
		stroke="currentColor"
		stroke-width={logoMark.strokeWidth}
		stroke-linecap="round"
	/>
	<path
		d={logoMark.rightLeg}
		fill="none"
		stroke="currentColor"
		stroke-width={logoMark.strokeWidth}
		stroke-linecap="round"
	/>
	<path
		d={logoMark.crossbar}
		fill="none"
		stroke="currentColor"
		stroke-width={logoMark.strokeWidth}
		stroke-linecap="round"
	/>
	<path
		d={logoMark.arc}
		fill="none"
		stroke="var(--logo-accent)"
		stroke-width={logoMark.arcStrokeWidth}
		stroke-linecap="round"
	/>
	<circle cx={logoMark.dot.cx} cy={logoMark.dot.cy} r={logoMark.dot.r} fill="var(--logo-warn)" />
</svg>
)}
