---
import { config } from "../config";

/**
 * Every configured social destination except github and sponsor, which the
 * header and footer already surface with labels of their own.
 */
const PLATFORMS = [
	{
		key: "x",
		label: "X",
		path: "M18.9 2H22l-6.8 7.8L22.6 22h-6.3l-4.9-6.4L5.6 22H2.5l7.2-8.2L1.8 2h6.4l4.6 6.1Z",
		filled: true,
	},
	{
		key: "bluesky",
		label: "Bluesky",
		path: "M12 10.8C11 8.9 8.2 5.3 5.6 3.5 3.1 1.7 2.2 2 1.6 2.3 0.9 2.6 0.8 3.7 0.8 4.4c0 0.7 0.4 5.6 0.6 6.4 0.8 2.7 3.6 3.6 6.2 3.3-3.8 0.6-7.2 2-2.8 6.9 4.9 5 6.7-1.1 7.2-4.2 0.5 3.1 1.6 9 7 4.2 4.1-4.2 1.1-6.3-2.7-6.9 2.6 0.3 5.4-0.6 6.2-3.3 0.2-0.8 0.6-5.7 0.6-6.4 0-0.7-0.1-1.8-0.8-2.1-0.6-0.3-1.5-0.6-4 1.2C15.8 5.3 13 8.9 12 10.8Z",
		filled: true,
	},
	{
		key: "mastodon",
		label: "Mastodon",
		path: "M21.3 14.9c-.3 1.6-2.7 3.3-5.5 3.6-1.5.2-2.9.4-4.4.3-2.5-.1-4.4-.6-4.4-.6 0 .2 0 .5.1.7.3 2.1 2.1 2.2 3.9 2.3 1.8 0 3.4-.4 3.4-.4v1.7s-1.3.7-3.5.8c-1.3.1-2.7 0-4.4-.5C2.7 21.6 2 17.6 1.9 13.6c0-1.2 0-2.3 0-3.2C2 6.3 3.2 4 5.6 3 6.8 2.5 8.9 2.2 11 2.2h.1c2.2 0 4.2.3 5.4.8 2.4 1 3.6 3.3 3.7 7.2 0 .9 0 2 0 3.2-.1.5-.5 1-.9 1.5Z",
		filled: true,
	},
	{
		key: "discord",
		label: "Discord",
		path: "M20.3 4.4A16.3 16.3 0 0 0 16.3 3l-.4.9a12 12 0 0 1 3.5 1.8 11.7 11.7 0 0 0-10.8 0A12 12 0 0 1 12 3.9L11.6 3a16.3 16.3 0 0 0-4 1.4C4.6 8.7 3.8 12.9 4.2 17a16.3 16.3 0 0 0 4.9 2.5l.8-1.4a11 11 0 0 1-1.9-.9l.4-.3a11.7 11.7 0 0 0 9.2 0l.4.3a11 11 0 0 1-1.9.9l.8 1.4a16.3 16.3 0 0 0 4.9-2.5c.4-4.1-.4-8.3-3.5-12.6ZM9.5 14.4c-1 0-1.7-.9-1.7-1.9s.8-1.9 1.7-1.9 1.8.9 1.7 1.9c0 1-.8 1.9-1.7 1.9Zm5 0c-1 0-1.7-.9-1.7-1.9s.8-1.9 1.7-1.9 1.8.9 1.7 1.9c0 1-.8 1.9-1.7 1.9Z",
		filled: true,
	},
	{
		key: "email",
		label: "Email",
		path: "M3 6h18v12H3zM3 6l9 7 9-7",
		filled: false,
	},
] as const;

const links = PLATFORMS.flatMap((platform) => {
	const value = config.social[platform.key];
	if (!value) return [];
	const href =
		platform.key === "email" && !value.includes(":")
			? `mailto:${value}`
			: value;
	return [{ ...platform, href }];
});
---

{links.length > 0 && (
	<div class="social-links">
		{links.map((link) => (
			<a
				class="social-link"
				href={link.href}
				aria-label={link.label}
				target={link.href.startsWith("mailto:") ? undefined : "_blank"}
			>
				<svg aria-hidden="true" viewBox="0 0 24 24">
					{link.filled ? (
						<path d={link.path} fill="currentColor" />
					) : (
						<path
							d={link.path}
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					)}
				</svg>
			</a>
		))}
	</div>
)}
