---
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { TableOfContents, VariantPicker } from "virtual:almanac/components";
import { siteConfig, config } from "../config";
import { buildSidebar, docHref, flattenNav } from "../utils/sidebar";
import {
	buildVariants,
	scopeEntries,
	scopedBase,
	stripPrefix,
	variantForId,
} from "../content/variants";
import { withBase } from "../lib/paths";

const { frontmatter, headings, entryId, gitLastUpdated } = Astro.props;
const title = frontmatter.title ?? "Docs";
const description =
	frontmatter.description ?? `${siteConfig.name} documentation.`;

// Per-page frontmatter overrides the site-wide setting in every case below.
const tocSetting = frontmatter.tableOfContents;
const showToc = tocSetting !== false;
const tocRange =
	tocSetting && typeof tocSetting === "object" ? tocSetting : undefined;

const editUrl = (() => {
	if (frontmatter.editUrl === false) return undefined;
	if (typeof frontmatter.editUrl === "string") return frontmatter.editUrl;
	if (!siteConfig.editUrl || !entryId) return undefined;
	const sourcePath = `${config.docs.path}/${entryId}.md`;
	return siteConfig.editUrl.includes("{path}")
		? siteConfig.editUrl.replace("{path}", sourcePath)
		: `${siteConfig.editUrl.replace(/\/$/, "")}/${sourcePath}`;
})();

const lastUpdated = (() => {
	if (frontmatter.lastUpdated === false) return undefined;
	if (frontmatter.lastUpdated instanceof Date) return frontmatter.lastUpdated;
	return gitLastUpdated;
})();
const lastUpdatedLabel = lastUpdated
	? new Intl.DateTimeFormat("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		}).format(lastUpdated)
	: undefined;

const docsEntries = await getCollection("docs");

// Every version and locale gets its own sidebar, scoped so that a reader of the
// 1.0 docs never follows a link into the current ones by accident.
const variants = buildVariants({
	base: config.docs.path,
	versions: config.versions,
	locales: config.i18n.locales,
	defaultLocale: config.i18n.defaultLocale,
});
const variant = (entryId ? variantForId(entryId, variants) : undefined) ??
	variants[0] ?? { prefix: "", sources: [] };
const variantBase = scopedBase(config.docs.base, variant.prefix);

const pageId = entryId ? stripPrefix(entryId, variant.prefix) : "index";

// A translated page has to declare its language, and a right to left script has
// to declare its direction, or the browser lays it out as if it were English.
const localeCode = variant.locale ?? config.i18n.defaultLocale;
const localeDir =
	config.i18n.locales.find((entry) => entry.code === localeCode)?.dir ?? "ltr";
const availableIds = new Set(docsEntries.map((entry) => entry.id));

const navGroups = buildSidebar(scopeEntries(docsEntries, variants, variant), {
	base: variantBase,
	sidebar: config.docs.sidebar,
});
const quickLinks = flattenNav(navGroups);
const docsRoot = docHref(variantBase, "index");

const basePath =
	import.meta.env.BASE_URL === "/"
		? ""
		: import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath =
	Astro.url.pathname.replace(basePath, "").replace(/\/$/, "") || "/";
const docsRootUrl = new URL(withBase(docsRoot), Astro.site ?? Astro.url).href;
const breadcrumbItems = [
	{
		"@type": "ListItem",
		position: 1,
		name: "Documentation",
		item: docsRootUrl,
	},
];

if (currentPath !== docsRoot.replace(/\/$/, "")) {
	breadcrumbItems.push({
		"@type": "ListItem",
		position: 2,
		name: title,
		item: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
	});
}

const structuredData = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: breadcrumbItems,
};

const isCurrent = (href: string) => {
	const normalized = href.replace(/\/$/, "") || "/";
	return normalized === currentPath;
};

const pagerIndex = quickLinks.findIndex((item) => isCurrent(item.href));

const resolvePager = (
	setting: unknown,
	fallback: { title: string; href: string } | undefined,
) => {
	if (setting === false) return undefined;
	if (setting && typeof setting === "object") {
		const override = setting as { link?: string; label?: string };
		if (override.link) {
			return { href: override.link, title: override.label ?? "Continue" };
		}
		if (override.label && fallback)
			return { ...fallback, title: override.label };
	}
	return fallback;
};

const prevItem = resolvePager(
	frontmatter.prev,
	pagerIndex > 0 ? quickLinks[pagerIndex - 1] : undefined,
);
const nextItem = resolvePager(
	frontmatter.next,
	pagerIndex !== -1 && pagerIndex < quickLinks.length - 1
		? quickLinks[pagerIndex + 1]
		: undefined,
);
const isSplash = frontmatter.template === "splash";

// Written into `dist/pdf/<id>.pdf` after the build, so the link is predictable
// from the entry id alone.
//
// Only the current version in the default locale is typeset. A variant page can
// share its source file with the page it inherits from, and the Markdown
// processor is handed a file path with no way to tell which variant it is
// rendering, so a variant PDF would silently be a copy of another one.
const pdfHref =
	config.future.pdf && entryId && variant.prefix === ""
		? withBase(`/pdf/${entryId}.pdf`)
		: undefined;
const showPager =
	!isSplash && config.docs.pager && Boolean(prevItem || nextItem);
---

<BaseLayout title={title} description={description} bodyClass="docs-page" structuredData={structuredData} head={frontmatter.head} lang={localeCode} dir={localeDir}>
	<div class:list={["docs-shell", { splash: isSplash }]}>
		{!isSplash && (
		<aside class="docs-sidebar" aria-label="Documentation navigation" data-pagefind-ignore>
			<a class="docs-home" href={withBase(docsRoot)}>Documentation</a>
			<VariantPicker
				pageId={pageId}
				currentVersion={variant.version}
				currentLocale={variant.locale}
				available={availableIds}
			/>
			{
				navGroups.map((group) => (
					<section>
						<h2>{group.title}</h2>
						<ul>
							{group.items.map((item) => (
								<li>
									<a class:list={{ active: isCurrent(item.href) }} href={withBase(item.href)}>
										{item.title}
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</aside>
		)}
		{!isSplash && (
		<div class="docs-mobile-panels" data-pagefind-ignore>
			<details class="docs-panel">
				<summary>Documentation</summary>
				<nav aria-label="Documentation navigation">
					{
						navGroups.map((group) => (
							<section>
								<h2>{group.title}</h2>
								<ul>
									{group.items.map((item) => (
										<li>
											<a class:list={{ active: isCurrent(item.href) }} href={withBase(item.href)}>
												{item.title}
											</a>
										</li>
									))}
								</ul>
							</section>
						))
					}
				</nav>
			</details>
			{showToc && (
			<details class="docs-panel">
				<summary>On this page</summary>
				<TableOfContents headings={headings} minDepth={tocRange?.minDepth} maxDepth={tocRange?.maxDepth} />
			</details>
			)}
		</div>
		)}
		<article class="docs-content" data-pagefind-body>
			{!isSplash && (
			<header class="docs-title">
				<h1>{title}</h1>
				{description && <span>{description}</span>}
			</header>
			)}
			<div class="prose">
				<slot />
			</div>
			{(editUrl || lastUpdatedLabel || pdfHref) && (
				<div class="docs-meta" data-pagefind-ignore>
					{lastUpdatedLabel && (
						<span class="docs-updated">Last updated {lastUpdatedLabel}</span>
					)}
					{pdfHref && (
						<a class="docs-pdf" href={pdfHref}>
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							PDF
						</a>
					)}
					{editUrl && (
						<a class="docs-edit" href={editUrl} target="_blank">
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<path d="M11 4H4v16h16v-7M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							Edit this page
						</a>
					)}
				</div>
			)}
			{showPager && (
			<nav class="docs-pager" aria-label="Docs pagination">
				{prevItem ? (
					<a class="docs-pager-link docs-pager-prev" href={withBase(prevItem.href)}>
						<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
						<span class="docs-pager-text">
							<span class="docs-pager-label">Previous</span>
							<span class="docs-pager-title">{prevItem.title}</span>
						</span>
					</a>
				) : (
					<span class="docs-pager-placeholder" />
				)}
				{nextItem ? (
					<a class="docs-pager-link docs-pager-next" href={withBase(nextItem.href)}>
						<span class="docs-pager-text">
							<span class="docs-pager-label">Next</span>
							<span class="docs-pager-title">{nextItem.title}</span>
						</span>
						<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</a>
				) : (
					<span class="docs-pager-placeholder" />
				)}
			</nav>
			)}
		</article>
		{showToc && !isSplash && <TableOfContents headings={headings} minDepth={tocRange?.minDepth} maxDepth={tocRange?.maxDepth} />}
	</div>
</BaseLayout>
