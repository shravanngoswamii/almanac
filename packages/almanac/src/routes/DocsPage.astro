---
import { type CollectionEntry, getCollection, render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { config } from "../config";
import { gitLastModified } from "../utils/gitDate";

export async function getStaticPaths() {
	const entries = await getCollection("docs");
	return entries
		.filter((entry) => !entry.data.draft)
		.map((entry) => ({
			params: {
				slug: entry.data.slug ?? (entry.id === "index" ? undefined : entry.id),
			},
			props: entry,
		}));
}

type Props = CollectionEntry<"docs">;

const entry = Astro.props;
const { Content, headings } = await render(entry);

// Resolved here rather than in the layout so the layout stays free of git and
// the filesystem. Frontmatter wins; this only fills the gap.
const gitDate =
	config.docs.lastUpdated &&
	entry.data.lastUpdated === undefined &&
	entry.filePath
		? gitLastModified(entry.filePath)
		: undefined;
---

<DocsLayout frontmatter={entry.data} headings={headings} entryId={entry.id} gitLastUpdated={gitDate}>
	<Content />
</DocsLayout>
