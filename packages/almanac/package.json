{
	"name": "almanac",
	"version": "0.0.0",
	"type": "module",
	"description": "A publishing framework for technical and scientific writing: docs, blog, and executable content from one source.",
	"license": "MIT",
	"author": "Shravan Goswami <contact@shravangoswami.com>",
	"homepage": "https://github.com/shravanngoswamii/almanac",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shravanngoswamii/almanac.git",
		"directory": "packages/almanac"
	},
	"keywords": [
		"astro",
		"astro-integration",
		"documentation",
		"docs",
		"blog",
		"myst",
		"executable",
		"publishing"
	],
	"exports": {
		".": "./src/index.ts",
		"./content": "./src/content/index.ts",
		"./components": "./src/components/index.ts",
		"./components/*": "./src/components/*",
		"./layouts/*": "./src/layouts/*",
		"./themes": "./src/themes/index.ts",
		"./paths": "./src/lib/paths.ts",
		"./styles/global.css": "./src/styles/global.css",
		"./package.json": "./package.json",
		"./exec": "./src/exec/index.ts"
	},
	"files": [
		"src"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"peerDependencies": {
		"astro": "^7.0.0",
		"@resvg/resvg-js": "^2.6.2",
		"satori": "^0.26.0",
		"pagefind": "^1.5.0",
		"asciinema-player": "^3.15.1",
		"@astrojs/markdown-remark": "^7.0.0"
	},
	"dependencies": {
		"@astrojs/rss": "^4.0.19"
	},
	"devDependencies": {
		"astro": "^7.1.3",
		"vite": "^7.0.0",
		"@types/node": "^25.6.2",
		"@resvg/resvg-js": "^2.6.2",
		"satori": "^0.26.0",
		"asciinema-player": "^3.15.1"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test \"test/*.test.ts\""
	},
	"peerDependenciesMeta": {
		"pagefind": {
			"optional": true
		},
		"asciinema-player": {
			"optional": true
		},
		"@astrojs/markdown-remark": {
			"optional": true
		}
	}
}
