---
import { getCollection } from "astro:content";
import BaseLayout from "almanac/layouts/BaseLayout.astro";
import { withBase } from "almanac/paths";

const docs = await getCollection("docs");
const docCount = docs.length;
---

<BaseLayout title="Almanac" description="A publishing framework for technical and scientific writing.">
	<section class="hero">
		<h1>One source. Docs, blog, and executed output.</h1>
		<div class="actions">
			<a class="button" href={withBase('/docs/')}>Read the docs</a>
			<a class="button secondary" href={withBase('/blog/')}>Blog</a>
		</div>
		<p class="hero-copy">
			<code>Almanac</code> is a publishing framework for technical and scientific
			writing. It renders {docCount} documentation pages, a blog, and 40+ themes
			from this repository, and it is built so the same content can reach print
			without a second source of truth.
		</p>
	</section>
</BaseLayout>
